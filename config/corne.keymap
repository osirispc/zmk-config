#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/* --- Keebmaker Corne: 21 per-key + 6 underglow = 27 LEDs per half --- */

&led_strip { chain-length = <27>; };

/ {
    /* ==========================================
     * Macros: hold layer + set RGB while held
     * ========================================== */

    macros {
        mo1_rgb: mo1_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo 1>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(231,100,50)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 1>;

            /* release: WHITE */

            label = "numbers";
        };

        mo2_rgb: mo2_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo 2>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(294,100,48)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 2>;

            /* release: WHITE */

            label = "navigation";
        };

        cooper_tag: cooper_tag {
            compatible = "zmk,behavior-macro";
            label = "COOPER_TAG";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap>,
                <&kp LS(C)>,
                <&macro_tap>,
                <&kp N0>,
                <&macro_tap>,
                <&kp N0>,
                <&macro_tap>,
                <&kp P>,
                <&macro_tap>,
                <&kp N3>,
                <&macro_tap>,
                <&kp R>,
                <&macro_tap>,
                <&kp LS(N6)>,
                <&macro_tap>,
                <&kp N3>,
                <&macro_tap>,
                <&kp N1>,
                <&macro_tap>,
                <&kp N5>;
        };

        mo3_set: mo3_set {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mo 3>,
                <&macro_tap>,
                <&rgb_ug RGB_COLOR_HSB(123,100,50)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 3>;

            label = "MO3_SET";
        };

        osirisortiz: osirisortiz {
            compatible = "zmk,behavior-macro";
            label = "OSIRISORTIZ";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_tap>,
                <&kp O &kp S &kp I &kp R &kp I &kp S &kp O &kp R &kp T &kp I &kp Z>;
        };
    };

    /* ==========================================
     * Home Row Mods (DEFINED ONCE, USED MANY TIMES)
     * ========================================== */

    behaviors {
        homerow_mods: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&kp ESC    &kp Q  &kp W                     &kp E                  &kp R                  &kp T        &kp Y      &kp U                  &kp I                  &kp O    &kp P      &kp BSPC
&kp TAB    &kp A  &homerow_mods LEFT_ALT S  &homerow_mods LCTRL D  &homerow_mods LSHFT F  &kp G        &kp H      &homerow_mods RSHFT J  &homerow_mods RCTRL K  &kp L    &kp SEMI   &kp SQT
&kp LSHFT  &kp Z  &kp X                     &kp C                  &kp V                  &kp B        &kp N      &kp M                  &kp COMMA              &kp DOT  &kp SLASH  &kp DEL
                         &kp LGUI               &mo 2                  &kp SPACE    &kp ENTER  &mo 1                  &mo 3
            >;

            label = "base";
        };

        NUM {
            bindings = <
&kp TILDE         &kp EXCL           &kp AT        &kp HASH      &kp DOLLAR    &kp PERCENT    &kp CARET     &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&kp GRAVE         &kp NUMBER_1       &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5         &kp NUMBER_6  &kp N7         &kp N8        &kp N9                &kp NUMBER_0           &kp PIPE
&kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp PLUS      &kp EQUAL     &kp UNDER     &kp MINUS      &kp MINUS     &kp RBRC       &kp LBKT      &trans                &kp LS(LBKT)           &kp LS(BSLH)
                                                   &kp UNDER     &kp MINUS     &kp PLUS       &trans        &trans         &trans
            >;

            label = "numbers";
        };

        NAV {
            bindings = <
&none  &none  &none  &none  &none  &none     &kp HOME  &kp PG_UP  &trans  &trans     &trans  &kp PSCRN
&none  &none  &none  &none  &none  &none     &kp LEFT  &kp DOWN   &kp UP  &kp RIGHT  &trans  &trans
&none  &none  &none  &none  &none  &none     &kp END   &kp PG_DN  &trans  &trans     &trans  &trans
                     &none  &none  &trans    &trans    &trans     &trans
            >;

            label = "navigation";
        };

        SET {
            label = "settings";
            bindings = <
&rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &rgb_ug RGB_COLOR_HSB(0,100,50)  &rgb_ug RGB_COLOR_HSB(236,100,50)  &rgb_ug RGB_COLOR_HSB(105,85,49)  &osirisortiz    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_SPI                  &rgb_ug RGB_SPD                    &rgb_ug RGB_COLOR_HSB(0,0,0)      &cooper_tag     &trans        &trans        &trans        &trans        &trans        &trans
&rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &rgb_ug RGB_BRI                  &rgb_ug RGB_BRD                    &none                             &none           &none         &trans        &trans        &trans        &trans        &trans
                                                                   &none                              &none                             &trans          &trans        &trans        &trans
            >;
        };
    };
};
